# Blockfrost API key (required) — get a free key at https://blockfrost.io
BLOCKFROST_PROJECT_ID=preprodXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Network: testnet (default), mainnet, preprod, preview
CARDANO_NETWORK=testnet

# Base directory for data (wallets, policies, database)
# Default: ~/.cardano-license/
CARDANO_LICENSE_DIR=~/.cardano-license/

# SQLite database path (default: {CARDANO_LICENSE_DIR}/license.db)
# CARDANO_LICENSE_DB=~/.cardano-license/license.db

# Encryption password for wallet key files
# If not set, you will be prompted interactively
# CARDANO_LICENSE_PASSWORD=
